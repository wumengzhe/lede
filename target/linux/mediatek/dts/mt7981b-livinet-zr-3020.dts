/dts-v1/;
#include "mt7981b-livinet-zr-3020.dtsi"

/ {
	model = "Livinet ZR-3020 (stock layout)";
	compatible = "livinet,zr-3020", "mediatek,mt7981";
};

&partitions {
	/*
	 * ubi 为末尾分区，声明到 512MiB 边界；
	 * 小容量颗粒上由内核 mtdpart 自动截断，UBI 自动撑满剩余空间。
	 * 注：dtsi 内 config2 (0x680000, 1MiB) 存放全部 MAC 地址，须保留；
	 * zrsave 为厂商保留区，纯大分区方案下不再保留。ubi 紧接 config2
	 * (0x780000) 起，撑满至 512MiB 边界。
	 */
	partition@780000 {
		label = "ubi";
		reg = <0x780000 0x1f880000>;
	};
};

&spi_nand {
	mediatek,nmbm;
	mediatek,bmt-max-ratio = <1>;
	mediatek,bmt-max-reserved-blocks = <64>;
};
