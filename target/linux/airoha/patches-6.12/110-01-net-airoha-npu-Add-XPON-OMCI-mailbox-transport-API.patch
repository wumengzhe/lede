 static void airoha_npu_wlan_irq_disable(struct airoha_npu *npu, int q)
 {
 	regmap_clear_bits(npu->regmap, REG_IRQ_RXDONE(q), NPU_IRQ_RX_MASK(q));
+}
+
+/* XPON / OMCI transport toward the on-die NPU XPON-HAL firmware.
+ *
+ * The Airoha NPU firmware bundles an XPON-HAL that terminates the
+ * optical link (serdes training, GTC framing, OMCI extraction).
+ * Linux reaches it through the same NPU mailbox (MBQ0) used for
+ * PPE/wlan, selected by the 4-bit mailbox function id
+ * (MBOX_MSG_FUNC_ID, GENMASK(14,11)). The exact func_id the
+ * firmware's XPON-HAL listens on is part of Airoha's proprietary
+ * xpon_bsp and is supplied by the consumer (kmod-airoha-pon) at
+ * call time, since it is not published.
+ *
+ * airoha_npu_xpon_msg_send() pushes a raw OMCI/G.988 message (or
+ * any XPON-HAL command) to the firmware. airoha_npu_xpon_
+ * register_ind() lets a consumer receive unsolicited indications:
+ * the NPU raises the mailbox interrupt (airoha_npu_mbox_handler)
+ * for every event, and the registered callback performs the
+ * payload read defined by Airoha's proprietary XPON-HAL.
+ */
+static airoha_npu_xpon_ind_cb xpon_ind_cb;
+static void *xpon_ind_priv;
+static DEFINE_SPINLOCK(xpon_ind_lock);
+
+int airoha_npu_xpon_register_ind(struct airoha_npu *npu,
+				 airoha_npu_xpon_ind_cb cb, void *priv)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&xpon_ind_lock, flags);
+	xpon_ind_cb = cb;
+	xpon_ind_priv = priv;
+	spin_unlock_irqrestore(&xpon_ind_lock, flags);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_npu_xpon_register_ind);
+
+static int airoha_npu_xpon_msg_send(struct airoha_npu *npu, u8 func_id,
+					const void *data, int len, gfp_t gfp)
+{
+	void *buf;
+	int err;
+
+	if (!npu || func_id > 15 || len <= 0)
+		return -EINVAL;
+
+	buf = kzalloc(len, gfp);
+	if (!buf)
+		return -ENOMEM;
+
+	memcpy(buf, data, len);
+	err = airoha_npu_send_msg(npu, func_id, buf, len);
+	kfree(buf);
+
+	return err;
 }
 
