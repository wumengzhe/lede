#!/bin/sh
# wuxuroute - 快速配置工具（WAN/LAN/WiFi MAC、LAN IP、主机名）
# 用法:
#   wuxuroute random                  随机生成 4 个 MAC + 主机名（输出到 stdout）
#   wuxuroute get                     读取当前值（wan_mac/lan_mac/wifi2g_mac/wifi5g_mac/lan_ip/hostname）
#   wuxuroute apply [wan_mac] [lan_mac] [wifi2g_mac] [wifi5g_mac] [hostname] [lan_ip]
#                                        把传入的值写入 network/wireless/system 并 reload（不重启）
#   wuxuroute apply-and-restart        apply + 重启网络/无线
#   wuxuroute apply-and-reboot         apply + 重启整个设备
#   wuxuroute boot                     启动时按 /etc/config/wuxuroute 的 auto_* 选项自动执行
#   wuxuroute factory-reset           清空/恢复默认

CONF=/etc/config/wuxuroute
NETWORK=/etc/config/network
WIRELESS=/etc/config/wireless
SYSTEM=/etc/config/system

log() { logger -t wuxuroute "$@"; echo "$@"; }
err() { logger -t wuxuroute -p err "$@"; echo "ERROR: $@" >&2; }

# ---------- 工具函数 ----------

# 读 N 字节 /dev/urandom 并转成连续 16 进制字符串（小写）
# 用 od (busybox) + tr；fallback 走 hexdump
rand_hex() {
	local n="${1:-4}"
	local out=""
	# 优先 od
	if command -v od >/dev/null 2>&1; then
		out=$(head -c "$n" /dev/urandom 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n\t')
		# 保留为 2*n 个字符
		out=${out:0:$((n*2))}
	fi
	# fallback: hexdump
	if [ -z "$out" ] || [ ${#out} -lt $((n*2)) ]; then
		if command -v hexdump >/dev/null 2>&1; then
			out=$(head -c "$n" /dev/urandom 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null)
			out=${out:0:$((n*2))}
		fi
	fi
	# fallback: dd + od
	if [ -z "$out" ] || [ ${#out} -lt $((n*2)) ]; then
		out=$(dd if=/dev/urandom bs=1 count="$n" 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n\t')
		out=${out:0:$((n*2))}
	fi
	# 兜底：空字符串
	echo "$out"
}

# 随机生成单播 MAC（本地管理位 0x02 置位、组播位 0x01 清零）
gen_mac() {
	local rnd
	rnd=$(rand_hex 4)
	[ -z "$rnd" ] && rnd="00000000"
	# 强转小写 + 补 0
	rnd=$(printf '%-8s' "$rnd" | tr ' ' '0')
	rnd=$(echo "$rnd" | tr '[:upper:]' '[:lower:]')
	# 首字节固定 02（unicast + locally administered）
	echo "02:00:${rnd:0:2}:${rnd:2:2}:${rnd:4:2}:${rnd:6:2}"
}

gen_hostname() {
	# 生成形如 PC-XXXXXX 的随机主机名
	local rnd
	rnd=$(rand_hex 3)
	[ -z "$rnd" ] && rnd="000000"
	rnd=$(printf '%-6s' "$rnd" | tr ' ' '0')
	rnd=$(echo "$rnd" | tr '[:lower:]' '[:upper:]')
	echo "PC-${rnd}"
}

# 取接口当前 MAC。优先 UCI 配置文件，其次 sysfs，最后 ifconfig
get_iface_mac() {
	local iface="$1"
	local mac=""

	# 1) 从 /etc/config/network 的 ifname 取
	if [ -n "$iface" ]; then
		mac=$(uci -q get network.${iface}.macaddr)
	fi
	# 2) 从 sysfs 取
	if [ -z "$mac" ] && [ -d "/sys/class/net/$iface" ]; then
		mac=$(cat "/sys/class/net/$iface/address" 2>/dev/null)
	fi
	# 3) ifconfig 兜底
	if [ -z "$mac" ] && command -v ifconfig >/dev/null 2>&1; then
		mac=$(ifconfig "$iface" 2>/dev/null | awk '/HWaddr/ {print $NF; exit}')
		mac=${mac:-$(ifconfig "$iface" 2>/dev/null | awk '/ether/ {print $2; exit}')}
	fi
	echo "$mac" | tr '[:upper:]' '[:lower:]'
}

# 取默认 WAN / LAN 接口名（来自 uci show network | head）
get_default_iface() {
	local role="$1"  # wan | lan
	local ifname
	ifname=$(uci -q get network.wan.device 2>/dev/null)
	[ -z "$ifname" ] && ifname=$(uci -q get network.wan.ifname 2>/dev/null)
	if [ "$role" = "wan" ]; then
		echo "${ifname:-wan}"
		return
	fi
	# lan
	ifname=$(uci -q get network.lan.device 2>/dev/null)
	[ -z "$ifname" ] && ifname=$(uci -q get network.lan.ifname 2>/dev/null)
	echo "${ifname:-lan}"
}

# 取 wifi-iface 第一个 device 的 MAC（默认 radio0/1 2.4G/5G）
get_wifi_radio_mac() {
	local phy="$1"  # mt7981/mt7986 等可作前缀查找，这里用 phy 物理设备
	[ -z "$phy" ] && phy=$(ls /sys/class/ieee80211/ 2>/dev/null | head -1)
	[ -d "/sys/class/ieee80211/$phy" ] || { echo ""; return; }
	cat "/sys/class/ieee80211/$phy/macaddress" 2>/dev/null | tr '[:upper:]' '[:lower:]'
}

# 取当前 hostname
get_hostname() {
	uci -q get system.@system[0].hostname 2>/dev/null \
		|| awk -F= '/^[[:space:]]*hostname[[:space:]]*=/ {gsub(/[\"'\'' ]/,"",$2); print $2; exit}' /etc/config/system \
		|| hostname
}

get_lan_ip() {
	uci -q get network.lan.ipaddr 2>/dev/null || echo "192.168.1.1"
}

# ---------- 子命令 ----------

cmd_random() {
	# 只随机生成并打印
	cat <<EOF
wan_mac=$(gen_mac)
lan_mac=$(gen_mac)
wifi2g_mac=$(gen_mac)
wifi5g_mac=$(gen_mac)
lan_ip=$(get_lan_ip)
hostname=$(gen_hostname)
EOF
}

cmd_get() {
	# 取当前值
	local wan_if lan_if
	wan_if=$(get_default_iface wan)
	lan_if=$(get_default_iface lan)
	local wmac0 wmac1
	# 找两个物理 radio 的 MAC（mt7981 通常 phy0/phy1）
	wmac0=$(ls /sys/class/ieee80211/ 2>/dev/null | sort | sed -n '1p')
	wmac1=$(ls /sys/class/ieee80211/ 2>/dev/null | sort | sed -n '2p')
	[ -n "$wmac0" ] && wmac0=$(cat "/sys/class/ieee80211/$wmac0/macaddress" 2>/dev/null | tr '[:upper:]' '[:lower:]')
	[ -n "$wmac1" ] && wmac1=$(cat "/sys/class/ieee80211/$wmac1/macaddress" 2>/dev/null | tr '[:upper:]' '[:lower:]')
	cat <<EOF
wan_mac=$(get_iface_mac "$wan_if")
lan_mac=$(get_iface_mac "$lan_if")
wifi2g_mac=$wmac0
wifi5g_mac=$wmac1
lan_ip=$(get_lan_ip)
hostname=$(get_hostname)
EOF
}

# 把值写入 UCI（不一定 reload，由调用方决定）
write_to_uci() {
	local wan_mac="$1" lan_mac="$2" wifi2g_mac="$3" wifi5g_mac="$4" hostname="$5" lan_ip="$6"

	local wan_if lan_if
	wan_if=$(get_default_iface wan)
	lan_if=$(get_default_iface lan)

	# 1) network
	[ -n "$wan_mac" ] && uci set network.${wan_if}.macaddr="$wan_mac" 2>/dev/null
	[ -n "$lan_mac" ] && uci set network.${lan_if}.macaddr="$lan_mac" 2>/dev/null
	[ -n "$lan_ip" ] && uci set network.lan.ipaddr="$lan_ip"
	[ -n "$lan_ip" ] && uci set network.lan.force_link='1' 2>/dev/null
	uci commit network

	# 2) wireless - 找所有 wifi-iface，按 section idx 改 macaddr
	# 2.4G = 默认 path 中 band 2g 那个；5G = band 5g。简化处理：按 idx 顺序，前半 2.4G 后半 5G。
	if [ -n "$wifi2g_mac" ] || [ -n "$wifi5g_mac" ]; then
		local idx
		# 默认 qca/mediatek mt798x 常见 layout: 第一个 wifi-iface = 2.4G，第二个 = 5G
		idx=0
		for iface in $(uci show wireless | grep '=wifi-iface$' | cut -d'=' -f1 | sort -t. -k2,2n); do
			local n=${iface##*.}
			local band
			band=$(uci -q get wireless.${n}.band 2>/dev/null)
			# 没显式 band 就用 hwmode 推断
			if [ -z "$band" ]; then
				local hwmode
				hwmode=$(uci -q get wireless.${n}.hwmode 2>/dev/null)
				[ "$hwmode" = "11a" ] || [ "$hwmode" = "11ac" ] || [ "$hwmode" = "11axa" ] && band="5g"
				[ -z "$band" ] && band="2g"
			fi
			case "$band" in
				2g|2G|bgn|g)
					[ -n "$wifi2g_mac" ] && uci set wireless.${n}.macaddr="$wifi2g_mac"
					;;
				5g|5G|ac|axa|an)
					[ -n "$wifi5g_mac" ] && uci set wireless.${n}.macaddr="$wifi5g_mac"
					;;
			esac
			idx=$((idx+1))
		done
		uci commit wireless
	fi

	# 3) hostname
	[ -n "$hostname" ] && uci set system.@system[0].hostname="$hostname"
	uci commit system
}

reload_services() {
	# 不重启设备，只重启网络/无线
	/etc/init.d/network reload 2>/dev/null
	/etc/init.d/dnsmasq reload 2>/dev/null
	# wifi 单独 reload（network reload 已覆盖，但 wifi 经常需要重启）
	/sbin/wifi reload 2>/dev/null
	sleep 1
	# 如果是立即模式，让 hostname 立即生效
	local hn
	hn=$(uci -q get system.@system[0].hostname 2>/dev/null)
	[ -n "$hn" ] && echo "$hn" > /proc/sys/kernel/hostname
}

# 接受 6 个参数：wan_mac lan_mac wifi2g_mac wifi5g_mac hostname lan_ip
#   [args] 全部省略 → 按 auto_* 决定生成（用于 LuCI "立即应用但仅刷新 auto 选项"）
cmd_apply() {
	local wm="${1:-}" lmm="${2:-}" w2m="${3:-}" w5m="${4:-}" hn="${5:-}" lip="${6:-}"
	if [ -z "$wm$lmm$w2m$w5m$hn$lip" ]; then
		# 无参数：按 auto_* 自动决定
		cmd_boot
		return $?
	fi
	write_to_uci "$wm" "$lmm" "$w2m" "$w5m" "$hn" "$lip"
	reload_services
	log "apply done"
}

cmd_apply_and_reboot() {
	local wm="${1:-}" lmm="${2:-}" w2m="${3:-}" w5m="${4:-}" hn="${5:-}" lip="${6:-}"
	if [ -z "$wm$lmm$w2m$w5m$hn$lip" ]; then
		# 无参数：取 wuxuroute 段里 last_* 的值（前端在按"重启"按钮时已写好）
		wm=$(uci -q get wuxuroute.@config[0].last_wan_mac)
		lmm=$(uci -q get wuxuroute.@config[0].last_lan_mac)
		w2m=$(uci -q get wuxuroute.@config[0].last_wifi2g_mac)
		w5m=$(uci -q get wuxuroute.@config[0].last_wifi5g_mac)
		hn=$(uci -q get wuxuroute.@config[0].last_hostname)
		lip=$(uci -q get wuxuroute.@config[0].last_lan_ip)
	fi
	write_to_uci "$wm" "$lmm" "$w2m" "$w5m" "$hn" "$lip"
	# 把这次的值存为下次 boot 的基线
	uci set wuxuroute.@config[0].last_wan_mac="$wm"  2>/dev/null
	uci set wuxuroute.@config[0].last_lan_mac="$lmm" 2>/dev/null
	uci set wuxuroute.@config[0].last_wifi2g_mac="$w2m" 2>/dev/null
	uci set wuxuroute.@config[0].last_wifi5g_mac="$w5m" 2>/dev/null
	uci set wuxuroute.@config[0].last_hostname="$hn"  2>/dev/null
	uci set wuxuroute.@config[0].last_lan_ip="$lip"   2>/dev/null
	uci commit wuxuroute
	log "rebooting in 3s..."
	sleep 3
	/sbin/reboot
}

cmd_boot() {
	# 启动时调用。按 auto_* 决定是否重新生成
	[ -f "$CONF" ] || return 0
	local auto_wan auto_lan auto_w2g auto_w5g auto_hn auto_lip
	auto_wan=$(uci -q get wuxuroute.@config[0].auto_wan_mac)
	auto_lan=$(uci -q get wuxuroute.@config[0].auto_lan_mac)
	auto_w2g=$(uci -q get wuxuroute.@config[0].auto_wifi2g_mac)
	auto_w5g=$(uci -q get wuxuroute.@config[0].auto_wifi5g_mac)
	auto_hn=$(uci -q get wuxuroute.@config[0].auto_hostname)
	auto_lip=$(uci -q get wuxuroute.@config[0].auto_lan_ip)

	local wm="" lmm="" w2m="" w5m="" hn="" lip=""
	[ "$auto_wan" = "1" ] && wm=$(gen_mac)
	[ "$auto_lan" = "1" ] && lmm=$(gen_mac)
	[ "$auto_w2g" = "1" ] && w2m=$(gen_mac)
	[ "$auto_w5g" = "1" ] && w5m=$(gen_mac)
	[ "$auto_hn"  = "1" ] && hn=$(gen_hostname)
	[ "$auto_lip" = "1" ] && lip=$(get_lan_ip)

	if [ -z "$wm$lmm$w2m$w5m$hn$lip" ]; then
		log "no auto-randomize flags set, skip"
		return 0
	fi

	log "boot auto-randomize: wm=$wm lmm=$lmm w2m=$w2m w5m=$w5m hn=$hn lip=$lip"
	write_to_uci "$wm" "$lmm" "$w2m" "$w5m" "$hn" "$lip"
	# reload 而非 reboot（boot 时 network 可能还在 start 流程中）
	/etc/init.d/network reload 2>/dev/null || true
	/sbin/wifi reload 2>/dev/null || true
}

cmd_factory_reset() {
	# 清空 macaddr，让驱动恢复出厂 MAC
	uci -q delete network.wan.macaddr
	uci -q delete network.lan.macaddr
	for iface in $(uci show wireless | grep '=wifi-iface$' | cut -d'=' -f1); do
		local n=${iface##*.}
		uci -q delete wireless.${n}.macaddr
	done
	uci commit network
	uci commit wireless
	reload_services
	log "factory reset done"
}

# ---------- main ----------

case "${1:-}" in
	random)           shift; cmd_random "$@" ;;
	get)              shift; cmd_get "$@" ;;
	apply)            shift; cmd_apply "$@" ;;
	apply-and-reboot) shift; cmd_apply_and_reboot "$@" ;;
	boot)           shift; cmd_boot "$@" ;;
	factory-reset)  shift; cmd_factory_reset "$@" ;;
	gen-mac)        shift; gen_mac ;;
	gen-hostname)   shift; gen_hostname ;;
	*)
		cat <<EOF
Usage: $0 {random|get|apply|apply-and-reboot|boot|factory-reset|gen-mac|gen-hostname} [args...]
EOF
		exit 1
		;;
esac
