# pon-manager default configuration
# Managed via LuCI (luci-app-pon) or `ponctl set ...`.
#
# Profile: Nokia Bell XG-040G-MD (AN7581, Jiuzhou BOSA)
#   SN        NBELB45F6727   (YP_Serial_Num from factory dump)
#   vendor    NBEL
#   equipid   XG-040G-MD      HW XG040GMDV10  SW NXGS1426V07t01
#   MAC       50:3D:7F:58:25:5E
#
# Factory-discovered defaults (do NOT use unless your OLT expects them):
#   LOID/SLID (Zhejiang sample) = w0054753dw
#   PLOAM password (Nokia default) = pqjb@ip6
# The values below are the Fujian Mobile credentials you supplied.

config pon 'config'
	option enabled '1'
	# hal_backend is selected in /etc/modprobe.d/airoha-pon.conf
	option lo_id '5912519971'   # Fujian Mobile LOID (SLID)
	option password '123456'    # Fujian Mobile LOID password (PLOAM)
	# ONU serial for OMCI ONU-G ME: 4 ASCII vendor chars + 8 hex digits,
	# e.g. "NBELB45F6727" where NBEL is the vendor id. If empty, omcid2
	# warns and the OLT must provision via LOID/password.
	option serial_no 'NBELB45F6727'
	option auth_method 'loid'   # loid | password | sn | hybrid
	option fec '0'              # 0=off, 1=on (XGS-PON FEC)
	# XG-040G-MD factory AccessType is XG-PON (see X_CMCC_UpLinkType=XG-PON
	# in the decoded config). Most CMCC OLTs negotiate XGSPON; flip to
	# 'xgspon' if your OLT requires symmetric 10G. This currently selects the
	# reported capability + seed; the on-wire mode is set by the OLT at GTC
	# (driver mode-register write is TODO).
	option mode 'xgpon'         # xgpon | xgspon | auto
