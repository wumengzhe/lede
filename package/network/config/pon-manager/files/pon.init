#!/bin/sh /etc/rc.common
# pon-manager init script: starts the PON management daemon (ponmgr) and the
# G.988 OMCI protocol daemon (omcid2).

START=95
STOP=10

USE_PROCD=1

start_service() {
	local enabled serial mode

	config_load pon
	config_get enabled config enabled 1
	config_get serial config serial_no ""
	config_get mode config mode "xgspon"

	[ "$enabled" = "1" ] || return

	procd_open_instance ponmgr
	procd_set_param command /usr/sbin/ponmgr -d
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# omcid2 needs the ONU serial in VVVVXXXXXXXX form. If UCI serial_no is
	# empty, it will warn and rely on LOID-based provisioning.
	procd_open_instance omcid2
	procd_set_param command /usr/sbin/omcid2 "$serial"
	procd_set_param env "OMCID2_SERIAL=$serial"
	[ "$mode" = "xgspon" ] && procd_append_param env "OMCID2_MODE=XGSPON"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

reload_service() {
	restart
}
