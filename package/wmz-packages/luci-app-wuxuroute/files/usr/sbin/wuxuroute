#!/bin/sh
# wuxuroute - 无序路由配置工具（WAN/LAN/WiFi MAC、LAN IP、主机名）
# 用法:
#   wuxuroute random                           随机生成 4 个 MAC + 主机名（输出到 stdout）
#   wuxuroute get                              读取当前值（含每个 WiFi SSID 的 MAC）
#   wuxuroute list-wifi                        枚举所有 wifi-iface 段（idx|section|device|ssid|mac|ifname）
#   wuxuroute status                           读取系统实际生效的 MAC（配置值 vs 实际值）
#   wuxuroute gen-mac [--oui X:Y:Z]            生成随机 MAC；带 --oui 则伪装成该厂商前缀
#   wuxuroute gen-hostname                     生成随机主机名
#   wuxuroute apply --wan-mac .. --lan-mac .. --lan-ip .. --hostname .. [--wifi idx mac]... [--schedule N]
#                                             把传入的值写入 network/wireless/system 并 reload（不重启）
#   wuxuroute apply-and-reboot ...              apply + 3 秒后重启设备
#   wuxuroute boot                             启动时按 /etc/config/wuxuroute 的 auto_* 选项自动执行
#   wuxuroute factory-reset                    清空所有手动 macaddr（恢复出厂 MAC）
#   wuxuroute schedule <0|1|2>                 设置定时自动更新（0 关 / 1 每天 / 2 每周）

CONF=/etc/config/wuxuroute
NETWORK=/etc/config/network
WIRELESS=/etc/config/wireless
SYSTEM=/etc/config/system

log() { logger -t wuxuroute "$@"; echo "$@"; }
err() { logger -t wuxuroute -p err "$@"; echo "ERROR: $@" >&2; }

# ---------- 工具函数 ----------

# 生成连续 16 进制字符串（小写）
# Busybox 最小版本也必带的工具链（不依赖 od / hexdump / xxd）：
#   head -c 64 /dev/urandom  →  拿一批 CSPRNG 字节
#   LC_ALL=C tr -dc 'a-f0-9' →  过滤出 hex 字符（每字节约 6.25% 是 hex）
#   head -c "$need"           →  掐前 N 个字符
# /dev/urandom 是内核 CSPRNG，永不阻塞、永不 EOF、每次读取独立，避免
# $RANDOM 在「一键随机全部」并发 4+ 个 gen_mac 请求时同种子问题。
# LC_ALL=C 保证 tr 按字节处理（不依赖 locale 大小写表）。
#
# 关键修复（2026-08-27）：原实现 `head -c | od -An -tx1 | tr -d ' \n'`
# 假设 busybox 编了 `od` applet；但 OpenWrt 最小镜像的 busybox 没 `od`，
# shell 解释器自己报 `/usr/sbin/wuxuroute: line 35: od: not found`。注意：
# 这条 stderr 是 sh 解释器对未知命令的报错【不是 od 子进程的 stderr】，
# pipeline 上的 `2>/dev/null` 拦不住 → 整条 shell stderr 漏到 stdout
# 前面 → cgi 把"错误串 + 兜底 MAC" 拼成 JSON 返回 → 前端 setVal 把错误
# 字符串当真 MAC 写到 input（"已随机生成所有字段" 但 input.value 是
# `/usr/sbin/...od:notfound02:00:00:00:00`）。改用纯 head+tr，链上没有
# 未知命令、不可能再触发同类 stderr 污染。
rand_hex() {
	local n="${1:-4}"
	local need=$((n * 2))
	local out=""
	# 循环抽取直到凑满 need 个 hex 字符：/dev/urandom 每字节仅 ~6.25% 是 hex
	# 字符（仅 16 个字节值 0x30-0x39/0x61-0x66 命中），单次 head -c 64 取出的
	# hex 字符期望只有 ~4 个，远少于 need。旧实现用 `head -c 64 | tr | head -c $need`
	# 拿到的往往是短串，再用 `printf '%-8s' | tr ' ' '0'` 补零 → MAC 尾段恒为 00
	# （用户反馈"看着假、后几位连续 0"）。改为循环累加到满足长度为止。
	while [ ${#out} -lt "$need" ]; do
		out="${out}$(head -c 256 /dev/urandom 2>/dev/null | LC_ALL=C tr -dc '0-9a-f')"
	done
	if [ -z "$out" ]; then
		# 极罕见：urandom 不可用（嵌入式 initramfs 等），退回 $RANDOM 拼接并循环补足。
		while [ ${#out} -lt "$need" ]; do
			out="${out}$(printf '%08x' $(( (RANDOM << 16) ^ RANDOM )) )"
		done
	fi
	echo "${out:0:$need}"
}

# 随机生成 MAC
# 不带参数：首字节 02（单播 + 本地管理位），避免与真实 MAC 冲突
# 带 --oui X:Y:Z：保留厂商前缀前 3 字节，后 3 字节随机（看起来像该厂商设备）
gen_mac() {
	local oui=""
	[ "$1" = "--oui" ] && oui="$2"
	# 规范化并校验 OUI：仅允许 3 个 hex 字节（可带 : / - 分隔，或连写 6 位 hex）。
	# 非法 OUI 直接退回全局随机（02: 本地管理位），避免生成畸形 MAC。
	if [ -n "$oui" ]; then
		local norm
		norm=$(printf '%s' "$oui" | tr '[:lower:]' '[:upper:]' | tr -d ':-')
		if printf '%s' "$norm" | grep -qE '^[0-9A-Fa-f]{6}$'; then
			oui=$(printf '%s:%s:%s' "${norm:0:2}" "${norm:2:2}" "${norm:4:2}")
		else
			oui=""
		fi
	fi
	local rnd
	rnd=$(rand_hex 4)
	[ -z "$rnd" ] && rnd="00000000"
	# rand_hex 现已可靠返回 8 个 hex 字符，无需补零（旧的补零会把短结果填成尾段 00）
	rnd=$(echo "$rnd" | tr '[:upper:]' '[:lower:]')
	if [ -n "$oui" ]; then
		# 厂商伪装：前 3 字节用厂商 OUI，后 3 字节随机（看起来像该厂商设备）
		echo "${oui}:${rnd:0:2}:${rnd:2:2}:${rnd:4:2}"
	else
		# 全局随机：首字节 02（单播 + 本地管理位），避免与真实 MAC 冲突
		echo "02:00:${rnd:0:2}:${rnd:2:2}:${rnd:4:2}:${rnd:6:2}"
	fi
}

gen_hostname() {
	local rnd
	rnd=$(rand_hex 3)
	[ -z "$rnd" ] && rnd="000000"
	rnd=$(echo "$rnd" | tr '[:lower:]' '[:upper:]')
	echo "PC-${rnd}"
}

# 取接口当前 MAC（逻辑名 wan/lan 会自动解析实际 netdev）
get_iface_mac() {
	local iface="$1"
	local dev="$iface"
	local real
	real=$(uci -q get network.${iface}.device 2>/dev/null)
	[ -z "$real" ] && real=$(uci -q get network.${iface}.ifname 2>/dev/null)
	[ -n "$real" ] && dev="$real"

	local mac=""
	mac=$(uci -q get network.${iface}.macaddr 2>/dev/null)
	if [ -z "$mac" ] && [ -d "/sys/class/net/$dev" ]; then
		mac=$(cat "/sys/class/net/$dev/address" 2>/dev/null)
	fi
	echo "$mac" | tr '[:upper:]' '[:lower:]'
}

# 取默认 WAN / LAN 逻辑接口名
get_default_iface() {
	local role="$1"
	local ifname
	if [ "$role" = "wan" ]; then
		ifname=$(uci -q get network.wan.device 2>/dev/null)
		[ -z "$ifname" ] && ifname=$(uci -q get network.wan.ifname 2>/dev/null)
		echo "${ifname:-wan}"
	else
		ifname=$(uci -q get network.lan.device 2>/dev/null)
		[ -z "$ifname" ] && ifname=$(uci -q get network.lan.ifname 2>/dev/null)
		echo "${ifname:-lan}"
	fi
}

# 枚举所有 wifi-iface 段
# 输出每行: idx|section_ref|device|ssid|macaddr|ifname
#
# 注意（2026-08-26 修正）：原实现 sed 只匹配匿名段 `wireless.@wifi-iface[N]=wifi-iface`，
# 而 OpenWrt 默认生成的段是【命名段】(`wireless.default_radio0=wifi-iface`)，导致整段
# wifi 列表永远是空，cbi page 报"未检测到 WiFi 接口"。这里同时匹配匿名段 + 命名段，
# UCI 段名规则仅允许字母数字下划线，故用 [^[:space:]=\\.]+ 即可涵盖。
wifi_list() {
	local i=0 sec dev ssid mac ifn
	local entries
	# 取所有 wifi-iface 段（去前缀 wireless. 与后缀 =wifi-iface），按段名稳定排序
	entries=$(uci -q show wireless 2>/dev/null \
		| awk -F= '$2=="wifi-iface" {sub(/^wireless\./,"",$1); print $1}' \
		| sort)
	for sec in $entries; do
		[ -z "$sec" ] && continue
		dev=$(uci -q get wireless.${sec}.device 2>/dev/null)
		ssid=$(uci -q get wireless.${sec}.ssid 2>/dev/null)
		mac=$(uci -q get wireless.${sec}.macaddr 2>/dev/null)
		ifn=$(uci -q get wireless.${sec}.ifname 2>/dev/null)
		echo "$i|$sec|$dev|$ssid|$mac|$ifn"
		i=$((i+1))
	done
}

# 取当前 hostname
get_hostname() {
	uci -q get system.@system[0].hostname 2>/dev/null \
		|| awk -F= '/^[[:space:]]*hostname[[:space:]]*=/ {gsub(/["'\'' ]/,"",$2); print $2; exit}' /etc/config/system \
		|| hostname
}

get_lan_ip() {
	uci -q get network.lan.ipaddr 2>/dev/null || echo "192.168.1.1"
}

# 解析一行 wifi_list 输出到局部变量
# 额外导出 _pwl_field：cbi form key，与 cbi.lua 第 sec_safe 规则保持一致
# （[A-Za-z0-9_] 之外的字符全部替换成 _），保证前后端用同一个 field 找得到 form input。
parse_wifi_line() {
	local line="$1"
	local rest
	_pwl_idx=${line%%|*};  rest=${line#*|}
	_pwl_sec=${rest%%|*};  rest=${rest#*|}
	_pwl_dev=${rest%%|*};  rest=${rest#*|}
	_pwl_ssid=${rest%%|*}; rest=${rest#*|}
	_pwl_mac=${rest%%|*};  rest=${rest#*|}
	_pwl_ifn=${rest%%|*}
	_pwl_field="wifi_mac_$(printf '%s' "${_pwl_sec:-}" | tr -c 'A-Za-z0-9_' '_')"
}

# ---------- 子命令 ----------

cmd_random() {
	# 已废弃：controller 不再调用此子命令；保留仅作调试 / 测试。
	# 改为动态从 wifi_list 拉，避免硬编码 0/1 给出虚假结果。
	cat <<EOF
wan_mac=$(gen_mac)
lan_mac=$(gen_mac)
lan_ip=$(get_lan_ip)
hostname=$(gen_hostname)
EOF
	local line
	for line in $(wifi_list); do
		parse_wifi_line "$line"
		echo "wifi_mac_${_pwl_sec}=$(gen_mac)"
	done
}

cmd_get() {
	local wan_if lan_if
	wan_if=$(get_default_iface wan)
	lan_if=$(get_default_iface lan)
	echo "wan_mac=$(get_iface_mac "$wan_if")"
	echo "lan_mac=$(get_iface_mac "$lan_if")"
	echo "hostname=$(get_hostname)"
	echo "lan_ip=$(get_lan_ip)"
	local i=0 line
	for line in $(wifi_list); do
		parse_wifi_line "$line"
		echo "wifi_${i}_ssid=${_pwl_ssid:-}"
		echo "wifi_${i}_sec=${_pwl_sec:-}"
		echo "wifi_${i}_field=${_pwl_field:-}"
		echo "wifi_${i}_mac=${_pwl_mac:-}"
		echo "wifi_${i}_device=${_pwl_dev:-}"
		i=$((i+1))
	done
	echo "wifi_count=$i"
}

cmd_list_wifi() {
	wifi_list
}

cmd_status() {
	echo "wan_mac=$(get_iface_mac "$(get_default_iface wan)")"
	echo "lan_mac=$(get_iface_mac "$(get_default_iface lan)")"
	echo "hostname=$(get_hostname)"
	echo "lan_ip=$(get_lan_ip)"
	local i=0 line
	for line in $(wifi_list); do
		parse_wifi_line "$line"
		local eff="${_pwl_mac:-}"
		if [ -z "$eff" ] && [ -n "$_pwl_ifn" ] && [ -d "/sys/class/net/$_pwl_ifn" ]; then
			eff=$(cat "/sys/class/net/$_pwl_ifn/address" 2>/dev/null)
		fi
		echo "wifi_${i}_ssid=${_pwl_ssid:-}"
		echo "wifi_${i}_device=${_pwl_dev:-}"
		echo "wifi_${i}_field=${_pwl_field:-}"
		echo "wifi_${i}_config_mac=${_pwl_mac:-none}"
		echo "wifi_${i}_effective_mac=${eff:-none}"
		i=$((i+1))
	done
	echo "wifi_count=$i"
}

# 把 MAC 写到接口段（非桥接直接生效）与桥接 device 段（LAN br-lan
# 必须写 device 段才生效），并尽量在线修改运行中的 netdev MAC。
# 原实现用接口逻辑名解析出的设备名（如 br-lan）直接
# uci set network.br-lan.macaddr —— 但 br-lan 只是 @device 段的 name
# 值，不是 UCI 段名，那条 set 静默失败，导致 LAN MAC 永远不生效。
apply_mac_to_iface() {
	local iface="$1" mac="$2"
	[ -z "$iface" ] || [ -z "$mac" ] && return
	log "mac: ifname=${iface} target=${mac}"

	# 1) 接口段（对直接 ifname 接口有效；bridge 段保留以兼容桥无 device 选项）
	uci set "network.${iface}.macaddr=${mac}" \
		|| log "mac: set network.${iface}.macaddr FAILED"
	log "mac: wrote network.${iface}.macaddr=${mac}"

	# 2) 解析该接口引用的设备名（bridge: br-lan；物理口: ethX）
	local dev=""
	dev=$(uci -q get "network.${iface}.device") \
		|| dev=$(uci -q get "network.${iface}.ifname")
	log "mac: ${iface} resolves to device='${dev}'"

	if [ -z "$dev" ]; then
		log "mac: no device resolved; relying on uci commit only"
		return 0
	fi

	# 3) 找到 name == dev 的 @device 段（桥接设备段），把 MAC 写在那里
	# sed 容忍缺引号：'network.${iface}.name=br-lan' 或 'name='br-lan''
	local sec
	sec=$(uci -q show network 2>/dev/null \
		| sed -n "s/^network\.\(@device\[[0-9]*\]\)\.name=['\"]\?${dev}['\"]\?$/\1/p" \
		| head -n1)
	if [ -n "$sec" ]; then
		uci set "network.${sec}.macaddr=${mac}" \
			|| log "mac: set network.${sec}.macaddr FAILED"
		log "mac: wrote network.${sec}.macaddr=${mac} (device=${dev})"
	else
		log "mac: no @device[] section found for device=${dev}"
	fi

	# 4) 尽量在线改运行中的 netdev；失败则交给后台 reload_services 走 netifd 重建。
	if [ ! -d "/sys/class/net/${dev}" ]; then
		NEED_NETIFD_REBUILD=1
		log "mac: device ${dev} not present; will need netifd rebuild via reload_services"
		return 0
	fi

	if ip link set dev "${dev}" address "${mac}" 2>/dev/null; then
		log "mac: ip link set ${dev} address OK"
		return 0
	fi

	if ifconfig "${dev}" hw ether "${mac}" 2>/dev/null; then
		log "mac: ifconfig ${dev} OK"
		return 0
	fi

	NEED_NETIFD_REBUILD=1
	log "mac: hot-set ${dev} failed; will need netifd rebuild via reload_services"
}

# 把 LAN IP 写到 uci 并标记 NEED_NETIFD_REBUILD。
# 与改 MAC 不同，IP 没有"在线 ip addr replace"的对等可靠做法
# （bridge + dhcp + dnsmasq 都耦合在 netifd 上），所有路径最终都要 netifd 重建。
# 为了不掐断管理口连接，重建交给后台 setsid 进程，前台只负责写 uci + 立即返回。
apply_ip_to_iface() {
	local iface="$1" new_ip="$2"
	[ -z "$iface" ] || [ -z "$new_ip" ] && return
	local cur
	cur=$(uci -q get network.${iface}.ipaddr 2>/dev/null)
	if [ "$cur" = "$new_ip" ]; then
		log "ip: ${iface} unchanged (${new_ip}); skip"
		return 0
	fi
	log "ip: ${iface} ${cur:-<unset>} -> ${new_ip}"
	uci set network.${iface}.ipaddr="$new_ip"
	uci set network.${iface}.force_link='1' 2>/dev/null || true
	NEED_NETIFD_REBUILD=1
	log "ip: NEED_NETIFD_REBUILD=1; backend reload_services will rebuild ${iface} for ${new_ip}"
}

# 把值写入 UCI（不 reload，由调用方决定）
# 参数: wan_mac lan_mac lan_ip hostname wifi_pairs
#   wifi_pairs 形如 "0=AA:BB:..;1=CC:.."
write_to_uci() {
	local wan_mac="$1" lan_mac="$2" lan_ip="$3" hostname="$4" wifi_pairs="$5"
	log "write_to_uci: wan=${wan_mac} lan=${lan_mac} ip=${lan_ip} hn=${hostname} wifi=${wifi_pairs}"

	# 1) network: MAC + IP（IP 也属于 network 段）
	[ -n "$wan_mac" ] && apply_mac_to_iface wan "$wan_mac"
	[ -n "$lan_mac" ] && apply_mac_to_iface lan "$lan_mac"
	[ -n "$lan_ip"  ] && apply_ip_to_iface lan "$lan_ip"
	uci commit network
	log "write_to_uci: step1 uci commit network done"

	# 2) wireless - 按段名写每个 wifi-iface 的 macaddr（支持匿名段 + 命名段）
	# 传参协议: wifi_pairs="sec=mac;sec=mac"
	if [ -n "$wifi_pairs" ]; then
		WIFI_TOUCHED=1
		local IFS=';'
		local pair sec mac
		for pair in $wifi_pairs; do
			sec=${pair%%=*}
			mac=${pair#*=}
			if [ -n "$sec" ] && [ -n "$mac" ]; then
				uci set wireless.${sec}.macaddr="$mac" 2>/dev/null
			fi
		done
		unset IFS
		uci commit wireless
		log "write_to_uci: step2 uci commit wireless done"
		# 回读校验：确认 uci 里确实落了新 MAC（排错用，logread -e wuxuroute 可见）
		local IFS=';'
		local p2 s2 m2
		for p2 in $wifi_pairs; do
			s2=${p2%%=*}
			m2=${p2#*=}
			local got
			got=$(uci -q get wireless.${s2}.macaddr 2>/dev/null)
			log "write_to_uci: verified wireless.${s2}.macaddr='${got}' (want '${m2}')"
		done
		unset IFS
	fi

	# 3) hostname
	[ -n "$hostname" ] && uci set system.@system[0].hostname="$hostname"
	uci commit system
	log "write_to_uci: step3 uci commit system done"

	# 4) 持久层核对 —— dump 当前 network 段所有 macaddr，让 logread 可读
	if [ -n "$wan_mac" ] || [ -n "$lan_mac" ]; then
		local dump
		dump=$(uci show network 2>/dev/null | grep -E "macaddr=" | tr '\n' '|')
		log "write_to_uci: uci dump mac: ${dump}"
	fi
}

# reload_services —— 关键教训（2026-08-26）：
# 任何同步的 lan/wan down/up、netifd 重启、wifi reload 都会掐断浏览器 ↔ uhttpd
# 在管理口的 TCP 连接，导致前端 ajax 收到 status=0 / 空 body / "net fail" 假失败，
# 即使后端已经写完 uci。
#
# 解决：把所有"会掐断管理口"的后续动作统统丢到【脱离当前 shell 的后台 detached
# setsid 进程】，fds 重定向到 /dev/null；cgi 父进程立刻 print apply done 后 return，
# HTTP 响应正常 flush 到浏览器；后台慢慢重建 netifd，互不干扰。
#
# 唯一保留同步动作：hostname 写 /proc/sys/kernel/hostname —— 不动网络栈。
reload_services() {
	# 1) 同步写 hostname 到内核（不动网络，立即可见）
	local hn
	hn=$(uci -q get system.@system[0].hostname 2>/dev/null)
	[ -n "$hn" ] && echo "$hn" > /proc/sys/kernel/hostname

	local need_rebuild="$NEED_NETIFD_REBUILD"
	local wifi_touched="$WIFI_TOUCHED"

	# 2) 没改 ip / wifi / hot-set 都成功 —— 啥都不必做
	if [ -z "$need_rebuild" ] && [ -z "$wifi_touched" ]; then
		log "reload: all hot-applied; nothing to rebuild"
		return 0
	fi

	log "reload: scheduling background rebuild (NEED_NETIFD_REBUILD=${need_rebuild:-0} WIFI_TOUCHED=${wifi_touched:-0})"

	# 3) 把破坏性动作丢后台（脱离 shell，cgi 退出后不会被打断）
	export NEED_NETIFD_REBUILD="$need_rebuild"
	export WIFI_TOUCHED="$wifi_touched"

	setsid sh -c '
		# 关键修复（2026-08-27）：detached 子 shell 继承的环境 PATH 可能不含
		# /sbin /usr/sbin，导致 ubus/ifup/logger 找不到 → 后台重建静默失败、
		# 运行接口 IP/MAC 不更新。先显式铺好 PATH。
		export PATH=/usr/sbin:/usr/bin:/sbin:/bin
		sleep 1
		need="${NEED_NETIFD_REBUILD:-}"
		wifi="${WIFI_TOUCHED:-}"

		if [ -n "$need" ]; then
			/etc/init.d/dnsmasq reload 2>/dev/null || true
			# 改 LAN IP：必须 down/up 整个接口才能强制重新应用新 IP。
			# 注意 `ifup lan` 在接口已 up 时是【no-op（不改 IP）】，reconf 在部分
			# 版本/桥接场景下不生效，因此直接用 down + up 保证重新拉起新 IP。
			# 此动作在后台 setsid 中执行（不掐断管理口 HTTP 响应）；前端已对改 IP
			# 场景弹确认框并倒计时跳转，体验上就是短暂断 5-15 秒。
			ubus call network.interface.lan down 2>/dev/null
			sleep 1
			ubus call network.interface.lan up 2>/dev/null || /sbin/ifup lan 2>/dev/null || true
			# 校验：确认运行接口已拿到 uci 里的新 IP（any 接口上都行）
			newip=$(uci -q get network.lan.ipaddr 2>/dev/null)
			if [ -n "$newip" ]; then
				ok=0
				for _ in 1 2 3 4 5 6 7 8; do
					if ip -4 addr show 2>/dev/null | grep -q "inet $newip/"; then ok=1; break; fi
					sleep 1
				done
				if [ "$ok" = "1" ]; then
					log "reload: lan IP $newip applied to running interface"
				else
					# 热切换彻底失败，按用户意愿回退到重启保底（该重启就重启）
					log "reload: WARN lan IP $newip NOT seen after rebuild (fallback reboot)"
					/sbin/reboot 2>/dev/null || true
				fi
			fi
			log "reload: background netifd rebuild done"
		fi

		if [ -n "$wifi" ]; then
			# 关键修复（2026-08-27）：不能用 `wifi reload`。
			# mac80211 的 MAC 是在 `wifi up` 的 setup 阶段通过
			# `ip link set <ifname> address <mac>` 写进去的；而 `wifi reload`
			# 只重新配置 hostapd/wpa_supplicant，不会重建 VIF，因此写在
			# uci 里的新 macaddr 不会生效到运行中的接口（网络-无线里仍是旧 MAC）。
			# 必须 down/up 整个 radio 才能强制重新应用 MAC。
			# 注意：wifi down/up 与有线 LAN 管理口无关，不会掐断 uhttpd 会话。
			log "reload: restarting WiFi radios to apply new MAC (wifi reload is insufficient)"
			/sbin/wifi down 2>/dev/null || true
			sleep 2
			/sbin/wifi up 2>/dev/null || true
			log "reload: background wifi down/up done"
		fi
	' >/dev/null 2>&1 </dev/null &

	disown 2>/dev/null || true
}

# 接受 --flag 形式参数
#   --wan-mac / --lan-mac / --lan-ip / --hostname  <val>
#   --wifi <sec> <mac>           可重复；sec=段名（兼容匿名 @wifi-iface[N] / 命名 default_radioN）
#   --schedule <0|1|2>           可选
cmd_apply() {
	local wan_mac="" lan_mac="" lan_ip="" hostname="" schedule=""
	local wifi_pairs=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--wan-mac)  wan_mac="$2"; shift 2;;
			--lan-mac)  lan_mac="$2"; shift 2;;
			--lan-ip)   lan_ip="$2";  shift 2;;
			--hostname) hostname="$2"; shift 2;;
			--schedule) schedule="$2"; shift 2;;
			--wifi)
				if [ -n "$2" ] && [ -n "$3" ]; then
					[ -n "$wifi_pairs" ] && wifi_pairs="$wifi_pairs;"
					wifi_pairs="$wifi_pairs$2=$3"
				fi
				shift 3;;
			*) shift;;
		esac
	done
	[ -n "$schedule" ] && set_schedule "$schedule"
	write_to_uci "$wan_mac" "$lan_mac" "$lan_ip" "$hostname" "$wifi_pairs"
	reload_services
	# 清掉函数级标志，避免下一次调用（同一进程）误带
	NEED_NETIFD_REBUILD=""
	WIFI_TOUCHED=""
	log "apply done"
}

cmd_apply_and_reboot() {
	local wan_mac="" lan_mac="" lan_ip="" hostname=""
	local wifi_pairs=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--wan-mac)  wan_mac="$2"; shift 2;;
			--lan-mac)  lan_mac="$2"; shift 2;;
			--lan-ip)   lan_ip="$2";  shift 2;;
			--hostname) hostname="$2"; shift 2;;
			--wifi)
				if [ -n "$2" ] && [ -n "$3" ]; then
					[ -n "$wifi_pairs" ] && wifi_pairs="$wifi_pairs;"
					wifi_pairs="$wifi_pairs$2=$3"
				fi
				shift 3;;
			*) shift;;
		esac
	done
	write_to_uci "$wan_mac" "$lan_mac" "$lan_ip" "$hostname" "$wifi_pairs"
	NEED_NETIFD_REBUILD=""
	WIFI_TOUCHED=""
	log "rebooting in 3s..."
	sleep 3
	/sbin/reboot
}

# 定时自动更新
# 接受旧值 0/1/2 兼容（0=关 1=每天04:00 2=每周一04:00），
# 也接受标准 5 段 cron 表达式（分 时 日 月 周）。
set_schedule() {
    local mode="$1"
    local cron_cmd="/usr/sbin/wuxuroute boot"
    local cron_expr=""

    case "$mode" in
        ""|0) cron_expr="" ;;
        1)    cron_expr="0 4 * * *" ;;
        2)    cron_expr="0 4 * * 1" ;;
        *)
            # 5 段：分 时 日 月 周。具体字符合法性交给 crontab 去判。
            if echo "$mode" | awk '{ exit !(NF==5) }'; then
                cron_expr="$mode"
            else
                log "invalid cron expression: '$mode' (expect 5 whitespace-separated fields)"
                return 1
            fi
            ;;
    esac

    uci -q set wuxuroute.@config[0].schedule="$cron_expr"
    uci commit wuxuroute

    # 清掉旧的 wuxuroute 行
    if [ -f /etc/crontabs/root ]; then
        sed -i '/wuxuroute boot/d' /etc/crontabs/root 2>/dev/null
    fi
    if [ -n "$cron_expr" ]; then
        echo "$cron_expr $cron_cmd" >> /etc/crontabs/root
        /etc/init.d/cron enable 2>/dev/null
        /etc/init.d/cron restart 2>/dev/null || true
        log "schedule enabled (cron='$cron_expr')"
    else
        log "schedule disabled"
    fi
}

cmd_boot() {
	[ -f "$CONF" ] || return 0
	local auto_wan auto_lan auto_wifi auto_hn auto_lip
	auto_wan=$(uci -q get wuxuroute.@config[0].auto_wan_mac)
	auto_lan=$(uci -q get wuxuroute.@config[0].auto_lan_mac)
	auto_wifi=$(uci -q get wuxuroute.@config[0].auto_wifi)
	auto_hn=$(uci -q get wuxuroute.@config[0].auto_hostname)
	auto_lip=$(uci -q get wuxuroute.@config[0].auto_lan_ip)

	local wm="" lmm="" hn="" lip="" wifi_pairs=""
	[ "$auto_wan" = "1" ] && wm=$(gen_mac)
	[ "$auto_lan" = "1" ] && lmm=$(gen_mac)
	[ "$auto_hn"  = "1" ] && hn=$(gen_hostname)
	[ "$auto_lip" = "1" ] && lip=$(get_lan_ip)
	if [ "$auto_wifi" = "1" ]; then
		# 为所有 WiFi SSID 生成随机 MAC
		local line
		for line in $(wifi_list); do
			parse_wifi_line "$line"
			[ -n "$wifi_pairs" ] && wifi_pairs="$wifi_pairs;"
			# 按段名编码（兼容匿名段 @wifi-iface[N] + 命名段 default_radioN）
			wifi_pairs="$wifi_pairs${_pwl_sec}=$(gen_mac)"
		done
	fi

	if [ -z "$wm$lmm$hn$lip$wifi_pairs" ]; then
		log "no auto-randomize flags set, skip"
		return 0
	fi

	log "boot auto-randomize: wm=$wm lmm=$lmm hn=$hn lip=$lip wifi_pairs=$wifi_pairs"
	write_to_uci "$wm" "$lmm" "$lip" "$hn" "$wifi_pairs"
	# 开机场景：与 cgi 不同，浏览器没在等响应，可以同步 reload。
	# 但 reload_services 已经全部后台化，这里无需特判。
	NEED_NETIFD_REBUILD=""
	WIFI_TOUCHED=""
	/etc/init.d/network reload 2>/dev/null || true
	# 同样不能用 wifi reload（不重建 VIF，MAC 不生效）：down/up 整个 radio
	/sbin/wifi down 2>/dev/null || true
	sleep 2
	/sbin/wifi up 2>/dev/null || true
}

cmd_factory_reset() {
	# 清空所有手动 macaddr，让驱动恢复出厂 MAC
	uci -q delete network.wan.macaddr
	uci -q delete network.lan.macaddr
	# 同时清掉桥接 device 段里被我们写的 macaddr
	for sec in $(uci show network 2>/dev/null | sed -n 's/^network\.\(@device\[[0-9]*\]\)\.macaddr=.*/\1/p'); do
		uci -q delete network.${sec}.macaddr
	done
	local line
		for line in $(wifi_list); do
			parse_wifi_line "$line"
			uci -q delete wireless.${_pwl_sec}.macaddr
		done
	uci commit network
	uci commit wireless
	reload_services
	NEED_NETIFD_REBUILD=""
	WIFI_TOUCHED=""
	log "factory reset done"
}

# ---------- main ----------

case "${1:-}" in
	random)           shift; cmd_random "$@" ;;
	get)              shift; cmd_get "$@" ;;
	list-wifi)        shift; cmd_list_wifi "$@" ;;
	status)           shift; cmd_status "$@" ;;
	apply)            shift; cmd_apply "$@" ;;
	apply-and-reboot) shift; cmd_apply_and_reboot "$@" ;;
	boot)             shift; cmd_boot "$@" ;;
	factory-reset)    shift; cmd_factory_reset "$@" ;;
	schedule)         shift; set_schedule "$@" ;;
	gen-mac)          shift; gen_mac "$@" ;;
	gen-hostname)     shift; gen_hostname ;;
	*)
		cat <<EOF
Usage: $0 {random|get|list-wifi|status|apply|apply-and-reboot|boot|factory-reset|schedule|gen-mac|gen-hostname} [args...]
EOF
		exit 1
		;;
esac
