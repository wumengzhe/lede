#!/bin/sh
# pon-vol: read/write the factory BOSA calibration and RI serial UBI volumes
# for the Airoha AN7581 XGSPON (Nokia XG-040G-MD).
# Usage:
#   pon-vol status            -> show bosa/ri volume node + size
#   pon-vol bosa <file>       -> write <file> into the "bosa" UBI volume
#   pon-vol ri   <file>       -> write <file> into the "ri"   UBI volume
set -e

VOL_BOSA="bosa"
VOL_RI="ri"

dev_for_vol() {
	local name="$1" info dev vid
	info=$(ubinfo -N "$name" 2>/dev/null) || return 1
	dev=$(printf '%s\n' "$info" | sed -n 's/.*(on \(ubi[0-9][0-9]*\)).*/\1/p')
	vid=$(printf '%s\n' "$info" | sed -n 's/Volume ID:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
	[ -n "$dev" ] && [ -n "$vid" ] || return 1
	echo "/dev/${dev}_${vid}"
}

vol_size() {
	ubinfo -N "$1" 2>/dev/null | sed -n 's/.*Size:[[:space:]]*\([0-9][0-9]*\).*/\1/p'
}

write_vol() {
	local name="$1" file="$2" node sz fsz
	node=$(dev_for_vol "$name") || { echo "ERR: volume $name not found (is PON driver loaded?)"; return 1; }
	[ -f "$file" ] || { echo "ERR: file $file missing"; return 1; }
	sz=$(vol_size "$name")
	fsz=$(wc -c < "$file")
	if [ -n "$sz" ] && [ "$fsz" -gt "$sz" ]; then
		echo "ERR: file ${fsz}B > volume ${sz}B for $name"
		return 1
	fi
	ubiupdatevol "$node" "$file" && echo "OK: wrote ${fsz}B to $name ($node)"
}

status() {
	for v in bosa ri; do
		local node sz
		node=$(dev_for_vol "$v" 2>/dev/null) || node="(absent)"
		sz=$(vol_size "$v" 2>/dev/null)
		echo "$v node=$node size=${sz:-?}"
	done
}

case "$1" in
	bosa)  write_vol "$VOL_BOSA" "$2" ;;
	ri)    write_vol "$VOL_RI"   "$2" ;;
	status) status ;;
	*)
		echo "usage: pon-vol <bosa|ri> <file>   |   pon-vol status"
		exit 1
		;;
esac
